# Copy to .env and fill in. Nothing here is required to boot -- the app runs with
# defaults and simply skips capabilities whose keys are missing.

# ---------------------------------------------------------------- storage
SOURCEHUB_DB_URL=sqlite:///./data/sourcehub.db
SOURCEHUB_MEDIA_DIR=./data/media

# ---------------------------------------------------------------- translation
# claude | google_free | deepl | none
TRANSLATE_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
DEEPL_API_KEY=

# ---------------------------------------------------------------- networking
# Residential/rotating proxy strongly recommended for AliExpress, DHgate, 1688.
# One URL, or several comma-separated for round-robin rotation. Each Fetcher takes
# the next in the pool and keeps it for the life of that crawl (switching exit IPs
# mid-session looks more suspicious than not rotating); a blocked request rotates.
# Format: http://user:pass@host:port[,http://user:pass@host2:port]
SOURCEHUB_PROXY=
SOURCEHUB_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/127.0.0.0 Safari/537.36

# ---------------------------------------------------------------- official APIs
# If set, the adapter uses the API instead of HTML scraping (faster + legal + stable).
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=

# --- Taobao / Tmall / 1688 without a login ---------------------------------
# These three require a logged-in session when scraped directly. A data-provider
# API avoids that entirely. Pick a preset from providers.yaml, set the key, then:
#     python -m sourcehub.cli provider-probe --preset otapi --keyword "usb hub"
# ...and set `driver: provider` for those sites in config.yaml.
#
# Presets: otapi | rapidapi_generic | agent_lookup | custom
# With a lookup-only preset (agent_lookup), use `driver: hybrid` in config.yaml --
# browser for discovery, this API for detail enrichment.
CN_PROVIDER_PRESET=otapi
CN_PROVIDER_KEY=
# Only needed to override the preset's own base_url (or for agent_lookup/custom).
CN_PROVIDER_BASE_URL=

# ---------------------------------------------------------------- browser driver
# Persisted Chromium profile used for taobao/tmall/1688. Log in ONCE by hand via
#   python -m sourcehub.cli browser-login --site taobao
# and the session cookies survive in this directory.
SOURCEHUB_BROWSER_PROFILE=./data/browser_profile
SOURCEHUB_HEADLESS=true

# ---------------------------------------------------------------- affiliate / agent ids
# Appended to outbound agent + marketplace links if present.
AGENT_REF_SUPERBUY=
AGENT_REF_WEGOBUY=
AGENT_REF_CSSBUY=
AGENT_REF_SUGARGOO=
AGENT_REF_HAGOBUY=

# ---------------------------------------------------------------- admin access
# Unset + bound to 127.0.0.1 -> admin is open (only this machine can reach it).
# Unset + bound to anything else -> admin refuses to serve, by design.
# Set -> admin requires HTTP Basic auth; any username, this string as the password.
# Basic auth sends this near-clear over plain HTTP: use it on a LAN or behind a
# TLS-terminating proxy.
SOURCEHUB_ADMIN_TOKEN=

# ---------------------------------------------------------------- robots.txt
# Off by default. Every one of these sites disallows large parts of itself to
# crawlers, so turning this on will stop most crawling. It exists so the choice is
# explicit rather than never considered. Check each site's terms either way.
SOURCEHUB_RESPECT_ROBOTS=false

# ---------------------------------------------------------------- eBay (US baseline)
# Free developer keys: https://developer.ebay.com  -> create a production app.
# Without these the adapter falls back to scraping the public search page.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# ------------------------------------------------------------- Octopart / Nexar
# Free keys: https://nexar.com. Aggregates Mouser, Digi-Key, LCSC and others behind
# one API, keyed on manufacturer part number. Without these Octopart is skipped.
OCTOPART_CLIENT_ID=
OCTOPART_CLIENT_SECRET=
